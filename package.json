{
  "name": "mathe-4",
  "private": true,
  "version": "1.0.0",
  "description": "Mathe-Übungsportal für die 4. Klasse (Grundschule, Deutschland)",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && vite build --ssr src/seo/prerender.tsx --outDir dist-ssr && node scripts/prerender.mjs && node scripts/check-dist.mjs && node scripts/check-operator.mjs --warn",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "check:operator": "node scripts/check-operator.mjs",
    "deploy": "node scripts/check-operator.mjs && npm run test && npm run build && firebase deploy --only hosting"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-mono": "^5.3.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource/andika": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
